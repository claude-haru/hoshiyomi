{
  "name": "astro-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "自分専用の本格占星術ウェブアプリ（PWA / GitHub Pages）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
